# Generate a long random secret before deployment.
SECRET_KEY=replace-with-a-long-random-secret
# Local SQLite is used when DATABASE_URL is not set.
# For persistent Render deployment, attach a PostgreSQL database and set DATABASE_URL.
DATABASE_URL=
FREE_DELIVERY_THRESHOLD=200
DELIVERY_FEE=20
MIN_ORDER_VALUE=100
FLASK_DEBUG=0
